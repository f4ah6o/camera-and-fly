diff --git a/overlay_rootfs/etc/init.d/rcS b/overlay_rootfs/etc/init.d/rcS
index bfa3cee..16bf4ab 100755
--- a/overlay_rootfs/etc/init.d/rcS
+++ b/overlay_rootfs/etc/init.d/rcS
@@ -2,6 +2,38 @@
 
 [ -f /etc/environment ] && . /etc/environment
 
+mtd_readonly_guard() {
+  # Require the complete source-defined layout; never skip missing flags.
+  for index in 0 1 2 3 4 5 6 7 ; do
+    flags_file=/sys/class/mtd/mtd${index}/flags
+    [ -r "$flags_file" ] || return 1
+    flags=`cat "$flags_file"` || return 1
+    case "$flags" in
+      0x*) digits=${flags#0x} ;;
+      *) return 1 ;;
+    esac
+    case "$digits" in
+      ''|*[!0-9a-fA-F]*) return 1 ;;
+    esac
+    # Linux MTD flags are 32-bit; bound input before shell arithmetic.
+    [ "${#digits}" -le 8 ] || return 1
+    [ $((flags & 1024)) -eq 0 ] || return 1
+  done
+  # Reject unexpected devices as well as an incomplete partition layout.
+  for flags_file in /sys/class/mtd/mtd*/flags ; do
+    case "$flags_file" in
+      /sys/class/mtd/mtd[0-7]/flags) ;;
+      *) return 1 ;;
+    esac
+  done
+  return 0
+}
+
+if ! mtd_readonly_guard ; then
+  echo "MTD read-only guard failed; stopping startup" >&2
+  exit 1
+fi
+
 # Start all init scripts in /etc/init.d
 # executing them in numerical order.
 #
